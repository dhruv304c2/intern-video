#!/bin/bash
# blocks commits with lint/type errors - see README "Quality gate"
set -e

if [ -f .venv/bin/activate ]; then
    source .venv/bin/activate
fi

ruff format --check core/ cli/ recall/ main.py tests/
ruff check core/ cli/ recall/ main.py tests/
basedpyright core/ cli/ recall/ main.py tests/
